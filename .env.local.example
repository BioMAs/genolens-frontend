# Frontend environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local (it is already in .gitignore).
#
# ALL variables must also be set in the Vercel dashboard (Project → Settings →
# Environment Variables) for production/preview deployments. Next.js bakes
# NEXT_PUBLIC_* values into the JS bundle at BUILD TIME; they will be undefined
# if they are not present when Vercel runs `next build`.

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the FastAPI backend, including the /api/v1 prefix. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Leave empty to disable Sentry error tracking.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
