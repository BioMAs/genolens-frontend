# Frontend environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local (it is already in .gitignore).
#
# ALL variables must also be set in the Vercel dashboard (Project → Settings →
# Environment Variables) for production/preview deployments. Next.js bakes
# NEXT_PUBLIC_* values into the JS bundle at BUILD TIME; they will be undefined
# if they are not present when Vercel runs `next build`.

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the FastAPI backend, including the /api/v2 prefix. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# ─── Self-hosted auth ─────────────────────────────────────────────────────────
# The session is held by cookies the API sets. The Next server and the
# middleware verify the gl_at access token locally, with the API's public keys.
# Both variables are read at RUNTIME and are not NEXT_PUBLIC_: AUTH_ISSUER must
# equal the API's `iss` claim; AUTH_JWKS_URL is the API's public key set.
AUTH_JWKS_URL=http://localhost:8001/api/v1/auth/jwks.json
AUTH_ISSUER=http://localhost:8001
# The API's AUTH_COOKIE_DOMAIN, same value (runtime, not NEXT_PUBLIC_). When a
# sign-out cannot reach the API, /auth/local-signout expires gl_at and gl_session
# from this server, and a browser only deletes a cookie whose Domain matches.
# Leave empty when the API leaves it empty (host-only cookies, local development).
AUTH_COOKIE_DOMAIN=
# Origin of the admin app: the only absolute URL a post-login `?next=` may point
# to. Read by the browser, so it is baked into the bundle at build time.
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Leave empty to disable Sentry error tracking.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
