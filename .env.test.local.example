# URL du frontend (dev server)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# URL de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Credentials de test Supabase (remplacer par de vraies valeurs)
TEST_USER_EMAIL=your-test@email.com
TEST_USER_PASSWORD=YourTestPassword123!
# Supabase (copier depuis .env.local si existant)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=                          # Leave empty to disable Sentry
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=                               # For source map upload (optional)
SENTRY_ORG=                                      # Sentry org slug (optional)
SENTRY_PROJECT=                                  # Sentry project slug (optional)